# Vorlage für .env – kopieren mit: cp .env.example .env
# Danach POSTGRES_PASSWORD ändern und in beiden URLs übernehmen.

# Postgres (Docker Compose)
POSTGRES_USER=tea
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tea

# Nuxt-Server / Prisma
DATABASE_URL=postgresql://tea:change-me@localhost:5432/tea
TEST_DATABASE_URL=postgresql://tea:change-me@localhost:5432/tea_test

# Ollama
OLLAMA_URL=http://localhost:11434

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Auth (02): Diese E-Mail wird bei Registrierung bzw. Serverstart automatisch Admin.
# Vor dem Öffnen der Registrierung setzen und selbst registrieren – sonst kann jemand anderes sie belegen!
ADMIN_EMAIL=
# Nur hinter einem Reverse Proxy auf true setzen (wertet dann X-Forwarded-For aus)
TRUST_PROXY=false
# Schlüssel für CSRF-Tokens, genau 32 Zeichen, in Production Pflicht: openssl rand -base64 24
NUXT_CSURF_ENCRYPT_SECRET=
