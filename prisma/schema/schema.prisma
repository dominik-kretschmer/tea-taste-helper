// Prisma-Schema für tea-taste-helper. Verbindung: prisma.config.ts (DATABASE_URL).
// Vektor-Spalten später als Unsupported("vector(768)"), Suche per $queryRaw (Overview §10).
// Aufgeteilt (00-chore/11): eine Datei pro Tabelle in kebab-case, Enums in enums.prisma,
// Many-to-many nur als Verbindungstabelle in eigener Datei. Diagramm: docs/datenmodell.md (npm run db:erd).
// Einige Objekte kennt Prisma nicht (partielle Unique-Indizes, CHECK, pg_trgm); sie stehen nur als SQL in den
// Migrationen und am Kopf der betroffenen Tabellen-Datei. Neue Migrationen deshalb mit --create-only erzeugen und
// vor dem Anwenden prüfen, dass sie keines dieser Objekte löschen (README, Abschnitt „Migrationen“).

generator client {
  provider = "prisma-client"
  output   = "../../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
